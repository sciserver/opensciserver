{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciServer resolved integration test plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requested",
    "tests"
  ],
  "properties": {
    "contractVersion": {
      "const": "1"
    },
    "requested": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "dependsOn",
          "after",
          "implementation",
          "selected"
        ]
      }
    }
  }
}
