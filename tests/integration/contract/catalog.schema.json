{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "dependsOn",
          "after",
          "implementation"
        ]
      }
    }
  },
  "required": [
    "contractVersion",
    "tests"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
