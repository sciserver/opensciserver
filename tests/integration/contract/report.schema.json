{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "error"
      ]
    },
    "requested": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped",
              "blocked"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "blockedBy": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "selected",
          "status",
          "durationSeconds",
          "blockedBy",
          "detail"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "properties": {
                "blockedBy": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "blockedBy": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed",
        "failed",
        "error",
        "skipped",
        "blocked"
      ]
    },
    "runnerError": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "contractVersion",
    "runId",
    "startedAt",
    "finishedAt",
    "outcome",
    "requested",
    "tests",
    "counts",
    "runnerError"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciserver.org/integration-tests/contract/v1/report.schema.json",
  "title": "SciServer integration runner report v1"
}
